{
  "name": "pong",
  "version": "1.0.0",
  "description": "Juego de Pong clásico en HTML, CSS y JavaScript puro. Sin dependencias, instalable como PWA y como app de escritorio (Electron).",
  "author": "mcifu",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node tools/server.js",
    "icons": "node tools/generate-icons.js && node tools/generate-ico.js",
    "desktop": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.1.0"
  },
  "build": {
    "appId": "com.mcifu.pong",
    "productName": "Pong",
    "electronLanguages": ["en-US", "es"],
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "manifest.webmanifest",
      "sw.js",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mcifu",
        "repo": "pong"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon-rounded.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
